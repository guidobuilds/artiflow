{
  "name": "artiflow-opencode-plugin",
  "version": "0.1.0",
  "description": "Artiflow for OpenCode: native tools, viewer links and skills for a self-hosted artifact library over the Artiflow HTTP API.",
  "license": "MIT",
  "author": "Guido Caffa",
  "homepage": "https://artiflow.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidobuilds/artiflow.git",
    "directory": "plugins/opencode"
  },
  "bugs": {
    "url": "https://github.com/guidobuilds/artiflow/issues"
  },
  "keywords": [
    "artiflow",
    "opencode",
    "opencode-plugin",
    "mcp",
    "artifacts",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./server": "./dist/server.mjs",
    "./server-source": "./src/index.ts",
    "./server-standalone": "./dist/server.mjs",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "skills",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "prepack": "node scripts/pack-plugin.mjs verify",
    "prepublishOnly": "npm run build && npm run build:server"
  },
  "devDependencies": {
    "@artiflow/domain": "*",
    "@artiflow/plugin-core": "*",
    "@artiflow/sdk": "*",
    "@opencode/plugin": "2.3.2",
    "esbuild": "^0.28.0",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "solid-js": "^1.9.19",
    "electron": "^45.4.1",
    "typescript": "^7.0.2",
    "@types/node": "^24.12.2"
  }
}
