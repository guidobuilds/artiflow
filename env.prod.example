# Production environment template for the VPS deployment (docker-compose.prod.yml).
# Copy this file to .env.prod on the VPS, fill every value, keep mode 0600 and
# NEVER commit .env.prod.

# --- Edge / TLS -----------------------------------------------------------
# Public DNS name pointing at the VPS. Caddy serves HTTPS automatically on
# 443 and redirects 80. For a first smoke test without DNS, use ":80".
ARTIFLOW_SITE_ADDRESS=artifacts.example.com

# --- Application ----------------------------------------------------------
# Public origin users browse: https + the site address, no trailing path.
ARTIFLOW_PUBLIC_ORIGIN=https://artifacts.example.com
# Optional extra Host authorities the MCP endpoint trusts; unset trusts only
# the public origin host. Set this if the proxy sends a Host it does not cover.
# ARTIFLOW_ALLOWED_HOSTS=api:8787,internal.local:9000
# Optional origin the process uses to fetch its own JWKS; unset derives
# http://127.0.0.1:<port> using ARTIFLOW_API_PORT (default 8787).
# ARTIFLOW_INTERNAL_ORIGIN=http://api-sidecar:8080
# At least 32 characters; generate with: openssl rand -hex 32
# Startup rejects the placeholder below, so the API cannot boot until this
# is replaced with a generated secret.
ARTIFLOW_AUTH_SECRET=replace-with-openssl-rand-hex-32

# --- External managed PostgreSQL ------------------------------------------
# Production requires TLS: keep ?sslmode=require, or use ?sslmode=verify-full
# to also verify the server certificate and hostname.
DATABASE_URL=postgres://USER:PASSWORD@managed-host:5432/artiflow?sslmode=require

# --- External S3-compatible object storage --------------------------------
# The bucket must already exist and stay private. No bucket is created here.
# The endpoint must be https in production; plain http is rejected at startup.
ARTIFLOW_S3_REGION=auto
ARTIFLOW_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
ARTIFLOW_S3_BUCKET=artiflow
ARTIFLOW_S3_ACCESS_KEY_ID=replace-with-access-key-id
ARTIFLOW_S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
# Path-style addressing is required by R2 and most non-AWS providers.
ARTIFLOW_S3_FORCE_PATH_STYLE=1
