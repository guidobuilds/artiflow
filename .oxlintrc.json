{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "no-debugger": "warn",
    "no-new-func": "warn",
    "no-var": "warn",
    "no-duplicate-imports": "warn",
    "no-unreachable": "warn",
    "no-explicit-any": "warn"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "plugins/opencode/dist/**", "drizzle/**"]
}
