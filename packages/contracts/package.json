  },
  "exports": {
    "./artifacts": "./src/artifacts.ts",
    "./document": "./src/document.ts",
    "./scene": "./src/scene.ts",
    "./shares": "./src/shares.ts",
    "./comments": "./src/comments.ts",
    "./admin": "./src/admin.ts",
    "./account": "./src/account.ts",
    "./settings": "./src/settings.ts",
    "./errors": "./src/errors.ts"
  },
  "scripts": {
