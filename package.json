{
  "name": "artiflow",
  "version": "0.1.0",
  "private": true,
  "description": "Artiflow: self-hosted HTML artifacts and Markdown documents created over MCP, with a permission-checked viewer.",
  "license": "MIT",
  "author": "Guido Caffa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidobuilds/artiflow.git"
  },
  "homepage": "https://github.com/guidobuilds/artiflow#readme",
  "bugs": {
    "url": "https://github.com/guidobuilds/artiflow/issues"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/opencode"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup:local": "node scripts/local.mjs setup",
    "check:local": "node scripts/local.mjs check",
    "setup:auth": "node scripts/auth-env.mjs",
    "setup:plugin": "bun install --frozen-lockfile",
    "build:plugin": "npm run build --prefix plugins/opencode && npm run build:server --prefix plugins/opencode",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local apps/api/src/adapters/postgres/db/migrate.ts",
    "user:invite": "bun apps/api/src/commands/invite.ts",
    "user:reset-password": "bun apps/api/src/commands/reset-password.ts",
    "dev": "bun scripts/dev.mjs",
    "deploy:up": "docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build",
    "deploy:logs": "docker compose --env-file .env.prod -f docker-compose.prod.yml logs -f",
    "deploy:down": "docker compose --env-file .env.prod -f docker-compose.prod.yml down",
    "dev:api": "bun apps/api/src/server.ts",
    "dev:web": "vite --config apps/dashboard/vite.config.ts",
    "web:dev": "bun run --filter '@artiflow/web' dev",
    "web:build": "bun run --filter '@artiflow/web' build",
    "web:check": "bun run --filter '@artiflow/web' check",
    "web:verify": "bun run web:check && bun run web:build && bun run --filter '@artiflow/web' verify",
    "check:docs": "node scripts/check-docs.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "format": "prettier --write .",
    "lint": "oxlint",
    "check:changed": "node scripts/check-changed.mjs",
    "audit": "node scripts/audit.mjs",
    "build": "bun run check:docs && bun run check:boundaries && vite build --config apps/dashboard/vite.config.ts && tsc -p tsconfig.api.json --noEmit",
    "prebuild": "node scripts/preflight.mjs",
    "typecheck": "tsc -p tsconfig.api.json --noEmit && bun run --filter '@artiflow/dashboard' typecheck",
    "pretypecheck": "node scripts/preflight.mjs",
    "test": "node --test test/*.test.ts",
    "pretest": "node scripts/preflight.mjs",
    "test:integration": "node --env-file=test/integration-config.example --test --test-concurrency=1 \"test/*.test.ts\" \"test/*.integration.ts\"",
    "test:auth": "node --env-file=.env.local --test test/auth-http.integration.ts",
    "test:oauth": "node --env-file=.env.local --test test/oauth-http.integration.ts"
  },
  "dependencies": {
    "@artiflow/domain": "*",
    "@aws-sdk/client-s3": "3.1152.0",
    "@better-auth/core": "1.7.10",
    "@better-auth/mcp": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "markdown-it": "^15.0.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7",
    "@artiflow/contracts": "*",
    "@artiflow/sdk": "*",
    "@artiflow/mcp-apps": "*",
    "@artiflow/plugin-core": "*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "0.31.11",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
