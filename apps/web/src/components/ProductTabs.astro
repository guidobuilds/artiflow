---
import Mark from "./Mark.astro";

const tabs = [
  { id: "html", title: "Web pages", body: "Dashboards, reports and sites, built in HTML.", doc: "Checkout conversion · October", meta: "v4", kind: "Page" },
  { id: "markdown", title: "Docs", body: "Specs, runbooks and notes your team keeps editing.", doc: "Rate limits for the public API", meta: "v5", kind: "Doc" },
  { id: "deck", title: "Decks", body: "Pitch an idea or report on a quarter.", doc: "Q3 business review", meta: "v3", kind: "Deck", soon: true },
  { id: "canvas", title: "Mockups", body: "Design screens on a canvas before anyone builds them.", doc: "Stays · home", meta: "v1", kind: "Canvas", soon: true },
];

const conv = [3.2, 3.3, 3.1, 3.4, 3.6, 3.7, 3.9, 3.8, 4.1, 4.2, 4.0, 4.3];
const prev = [3.2, 3.1, 3.3, 3.2, 3.3, 3.1, 3.2, 3.4, 3.3, 3.2, 3.3, 3.3];
const yTicks = [3, 3.5, 4, 4.5];
const r2 = (n: number) => Math.round(n * 100) / 100;
const xAt = (i: number) => r2((i / (conv.length - 1)) * 100);
const yAt = (v: number) => r2(100 - ((v - 2.8) / 1.8) * 100);
const toPath = (values: number[]) => values.map((v, i) => `${i ? "L" : "M"}${xAt(i)} ${yAt(v)}`).join(" ");
const nowPath = toPath(conv);
const prevPath = toPath(prev);
function spark(values: number[]) {
  const lo = Math.min(...values);
  const hi = Math.max(...values);
  return values.map((v, i) => `${i ? "L" : "M"}${r2((i / (values.length - 1)) * 100)} ${r2(28 - ((v - lo) / (hi - lo)) * 26)}`).join(" ");
}
const kpis = [
  { label: "Conversion", value: "3.9%", delta: "+0.6 pt", spark: spark(conv) },
  { label: "Revenue", value: "€412k", delta: "+18%", spark: spark([88, 92, 90, 97, 101, 99, 108, 112, 110, 118, 121, 126]) },
  { label: "Average order", value: "€54", delta: "+3%", spark: spark([52, 53, 52, 52, 53, 54, 53, 54, 55, 54, 54, 55]) },
];
const funnel = [
  ["Cart", "12,480", 100],
  ["Shipping", "8,990", 72],
  ["Payment", "7,240", 58],
  ["Purchased", "4,870", 39],
] as const;

const toc = ["Summary", "Proposal", "Limits by plan", "Rollout", "Open questions"];
const limits = [
  ["Free", "60", "120"],
  ["Team", "600", "1,200"],
  ["Business", "3,000", "6,000"],
];
const rollout = [
  { text: "Send rate-limit headers in shadow mode", done: true },
  { text: "Email Business accounts above 80% of their limit", done: true },
  { text: "Enforce limits on November 30", done: false },
];

const arr = [2.1, 2.4, 2.7, 3.0, 3.6, 4.2];
const chartPoints = arr.map((v, i) => [i * 60, Math.round(150 - (v - 1.6) * 45)] as const);
const line = chartPoints.map(([x, y], i) => `${i ? "L" : "M"}${x} ${y}`).join(" ");
const slides = ["cover", "agenda", "market", "growth", "plan"];
---

<div class="pt" data-tabs>
  <div class="pt-list" role="tablist" aria-label="What you can make">
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`pt-tab-${t.id}`}
          aria-controls={`pt-panel-${t.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          <b>
            {t.title}
            {t.soon && <span class="pt-soon">Soon</span>}
          </b>
          <span>{t.body}</span>
        </button>
      ))
    }
  </div>

  <div class="pt-window">
    {
      tabs.map((t, i) => (
        <div class="pt-panel" role="tabpanel" id={`pt-panel-${t.id}`} aria-labelledby={`pt-tab-${t.id}`} hidden={i !== 0}>
          <div class="pt-bar">
            <span class="pt-cell pt-mark">
              <Mark label="artiflow" />
            </span>
            <span class="pt-cell pt-title">
              <b>{t.doc}</b>
              <span class="mono">{t.meta}</span>
            </span>
            <span class="pt-grow" />
            {t.soon && (
              <span class="pt-cell pt-soon-cell">
                <span class="pt-badge">Coming soon</span>
              </span>
            )}
            <span class="pt-cell pt-kind">{t.kind}</span>
            <span class="pt-cell">
              <span class="pt-share">Share</span>
            </span>
          </div>
          <div class:list={["pt-body", `pt-${t.id}`]} aria-hidden="true">
            {t.id === "html" && (
              <div class="report">
                <header class="report-head">
                  <div class="report-titles">
                    <span class="report-kicker">Growth · Weekly report</span>
                    <b class="report-title">Checkout conversion is up 18% since the redesign</b>
                    <span class="report-sub">Oct 1 – Oct 28 · updated 2 h ago by your agent</span>
                  </div>
                  <div class="report-controls">
                    <span class="seg">
                      <span>7d</span>
                      <span class="on">30d</span>
                      <span>90d</span>
                    </span>
                    <span class="chip">All regions ▾</span>
                  </div>
                </header>
                <div class="kpis">
                  {kpis.map((k) => (
                    <div class="kpi">
                      <span class="kpi-label">{k.label}</span>
                      <span class="kpi-row">
                        <b>{k.value}</b>
                        <svg class="spark" viewBox="0 0 100 30" preserveAspectRatio="none">
                          <path d={k.spark} />
                        </svg>
                      </span>
                      <span class="kpi-delta">
                        {k.delta} <span class="kpi-vs">vs. September</span>
                      </span>
                    </div>
                  ))}
                </div>
                <div class="report-main">
                  <div class="panel">
                    <div class="panel-head">
                      <b>Conversion rate</b>
                      <span class="legend">
                        <i class="key now" />
                        October
                        <i class="key prev" />
                        September
                      </span>
                    </div>
                    <div class="plot">
                      {yTicks.map((v) => (
                        <span class="y-tick" style={`top: ${yAt(v)}%`}>
                          {v.toFixed(1)}%
                        </span>
                      ))}
                      <div class="plot-area">
                        <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                          {yTicks.map((v) => (
                            <path class="grid" d={`M0 ${yAt(v)} H100`} />
                          ))}
                          <path class="area" d={`${nowPath} L100 100 L0 100 Z`} />
                          <path class="prev" d={prevPath} />
                          <path class="now" d={nowPath} />
                          <path class="marker" d={`M${xAt(3)} 0 V100`} />
                        </svg>
                        <span class="note" style={`left: ${xAt(3)}%`}>Redesign shipped</span>
                        <span class="pt-dot" style={`left: ${xAt(9)}%; top: ${yAt(conv[9]!)}%`} />
                        <span class="pt-dot prev" style={`left: ${xAt(9)}%; top: ${yAt(prev[9]!)}%`} />
                        <span class="tip" style={`left: ${xAt(9)}%; top: ${yAt(conv[9]!)}%`}>
                          <b>Oct 23</b>
                          <span>
                            <i class="key now" />
                            4.2%
                          </span>
                          <span>
                            <i class="key prev" />
                            3.2%
                          </span>
                        </span>
                      </div>
                      <div class="x-ticks">
                        {["Oct 1", "Oct 8", "Oct 15", "Oct 22", "Oct 28"].map((d) => (
                          <span>{d}</span>
                        ))}
                      </div>
                    </div>
                  </div>
                  <div class="panel funnel">
                    <div class="panel-head">
                      <b>Checkout funnel</b>
                    </div>
                    {funnel.map(([step, count, pct]) => (
                      <div class="step">
                        <span class="step-row">
                          <span>{step}</span>
                          <span class="step-n">{count}</span>
                        </span>
                        <span class="step-bar">
                          <span style={`width: ${pct}%`} />
                        </span>
                        <span class="step-pct">{pct}%</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {t.id === "markdown" && (
              <div class="doc-page">
                <nav class="doc-toc">
                  <span class="doc-toc-head">On this page</span>
                  {toc.map((item, n) => (
                    <span class:list={{ on: n === 2 }}>{item}</span>
                  ))}
                </nav>
                <article class="doc">
                  <span class="doc-crumb">Engineering / RFCs / 0142</span>
                  <h3>Rate limits for the public API</h3>
                  <div class="doc-meta">
                    <span class="doc-status">In review</span>
                    <span>Platform team</span>
                    <span>Updated 2 days ago</span>
                  </div>
                  <p class="doc-summary">
                    Limits move from one global cap to per-plan quotas, so a single noisy integration can no longer slow everyone else
                    down.
                  </p>
                  <h4>Limits by plan</h4>
                  <p>
                    Each key gets a per-minute quota and a short burst allowance. Responses carry <code>RateLimit-Remaining</code> and{" "}
                    <code>Retry-After</code> so clients can back off on their own.
                  </p>
                  <table>
                    <thead>
                      <tr>
                        <th>Plan</th>
                        <th>Requests / min</th>
                        <th>Burst</th>
                      </tr>
                    </thead>
                    <tbody>
                      {limits.map(([plan, rpm, burst]) => (
                        <tr>
                          <td>{plan}</td>
                          <td>{rpm}</td>
                          <td>{burst}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  <h4>Rollout</h4>
                  <ul class="checks">
                    {rollout.map((r) => (
                      <li class:list={{ done: r.done }}>{r.text}</li>
                    ))}
                  </ul>
                </article>
              </div>
            )}

            {t.id === "deck" && (
              <div class="deck">
                <div class="strip">
                  {slides.map((s, n) => (
                    <span class:list={["thumb", `thumb-${s}`, { on: n === 3 }]}>
                      <span class="thumb-n">{n + 1}</span>
                    </span>
                  ))}
                </div>
                <div class="stage">
                  <div class="slide">
                    <div class="slide-copy">
                      <span class="slide-kicker">Q3 review · Growth</span>
                      <b class="slide-title">Revenue up 38%, churn cut in half.</b>
                      <div class="slide-stats">
                        <span>
                          <b>$4.2M</b>ARR
                        </span>
                        <span>
                          <b>1.9%</b>Monthly churn
                        </span>
                        <span>
                          <b>112%</b>Net retention
                        </span>
                      </div>
                    </div>
                    <svg class="slide-chart" viewBox="-6 -6 312 172">
                      <path class="area" d={`${line} L300 160 L0 160 Z`} />
                      <path class="trend" d={line} />
                      <circle cx={chartPoints[3]![0]} cy={chartPoints[3]![1]} r="4.5" />
                      <text x={chartPoints[3]![0] - 6} y={chartPoints[3]![1] - 12} text-anchor="end">
                        Team plan launch
                      </text>
                    </svg>
                    <span class="slide-foot">Acme · Board meeting</span>
                    <span class="slide-page">04</span>
                  </div>
                </div>
              </div>
            )}

            {t.id === "canvas" && (
              <div class="canvas">
                <span class="frame-label phone-label">Home · Mobile</span>
                <div class="phone">
                  <span class="app-hello">Good morning, Ana</span>
                  <b class="app-title">Where to next?</b>
                  <span class="app-search">Search stays</span>
                  <div class="app-card">
                    <span class="app-photo" />
                    <b>Lisbon, Alfama</b>
                    <span>3 nights · from €118</span>
                  </div>
                  <div class="app-row">
                    <span class="app-thumb t1" />
                    <span>
                      <b>Porto riverside</b>Weekend · €96
                    </span>
                  </div>
                  <div class="app-row">
                    <span class="app-thumb t2" />
                    <span>
                      <b>Sintra cottage</b>2 nights · €140
                    </span>
                  </div>
                </div>

                <span class="frame-label web-label">Home · Desktop</span>
                <div class="web">
                  <div class="web-nav">
                    <b>stays</b>
                    <span>Destinations</span>
                    <span>Journal</span>
                    <span class="web-btn">Sign in</span>
                  </div>
                  <div class="web-hero">
                    <div class="web-copy">
                      <b>Find a stay you'll remember.</b>
                      <span>Small places, picked by people who have slept there.</span>
                      <span class="web-cta">Explore stays</span>
                    </div>
                    <div class="web-photo">
                      <span class="sel-size">480 × 320</span>
                      <i class="h tl" />
                      <i class="h tr" />
                      <i class="h bl" />
                      <i class="h br" />
                    </div>
                  </div>
                  <span class="cursor">
                    <svg viewBox="0 0 16 16">
                      <path d="M2 1l11 6-5 1.5L5.5 14z" />
                    </svg>
                    <span>Your agent</span>
                  </span>
                </div>

                <div class="props">
                  <b>Image</b>
                  <div class="props-grid">
                    <span>W</span>
                    <span>480</span>
                    <span>H</span>
                    <span>320</span>
                    <span>X</span>
                    <span>640</span>
                    <span>Y</span>
                    <span>120</span>
                  </div>
                  <span class="props-row">
                    Fill <i class="swatch" />
                    <span class="mono">#E9B49A</span>
                  </span>
                  <span class="props-row">
                    Radius <span class="mono">16</span>
                  </span>
                </div>

                <div class="tools">
                  <svg viewBox="0 0 24 24" class="on">
                    <path d="M5 3l12 7-6 1.6L8.5 18z" />
                  </svg>
                  <svg viewBox="0 0 24 24">
                    <path d="M7 3v18M17 3v18M3 7h18M3 17h18" />
                  </svg>
                  <svg viewBox="0 0 24 24">
                    <rect x="4" y="5" width="16" height="14" rx="2" />
                  </svg>
                  <svg viewBox="0 0 24 24">
                    <path d="M5 6V4h14v2M12 4v16M9 20h6" />
                  </svg>
                  <svg viewBox="0 0 24 24">
                    <path d="M4 20l4-1L19 8a2.1 2.1 0 0 0-3-3L5 16z" />
                  </svg>
                </div>
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (next: HTMLButtonElement) => {
      for (const tab of tabs) {
        const on = tab === next;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length]!;
        select(next);
        next.focus();
      });
    });
  }
</script>

<style>
  .pt {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .pt-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .pt-list button {
    text-align: left;
    padding: 14px 0 4px;
    border: none;
    border-top: 2px solid var(--line);
    background: transparent;
    color: var(--fg-muted);
    font: inherit;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: border-color 120ms var(--ease);
  }
  .pt-list button:hover {
    border-top-color: var(--line-strong);
  }
  .pt-list button[aria-selected="true"] {
    border-top-color: var(--fg);
    color: var(--fg);
  }
  .pt-list b {
    font-weight: 500;
    font-size: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pt-list span {
    font-size: 13.5px;
    color: var(--fg-subtle);
  }
  .pt-list .pt-soon {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.04em;
    padding: 1px 6px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--fg-muted);
  }
  .pt-list button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .pt-window {
    border-radius: 14px;
    border: 1px solid var(--line);
    overflow: hidden;
    box-shadow: 0 24px 64px var(--shadow);
    height: 600px;
    background: var(--bg-raised);
  }
  .pt-panel {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .pt-panel[hidden] {
    display: none;
  }
  .pt-bar {
    height: 48px;
    flex: none;
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }
  .pt-cell {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border-right: 1px solid var(--line);
  }
  .pt-cell:last-child {
    border-right: none;
    padding: 0 8px;
  }
  .pt-grow {
    flex: 1;
    border-right: 1px solid var(--line);
  }
  .pt-mark {
    width: 20px;
    box-sizing: content-box;
  }
  .pt-mark :global(svg) {
    width: 20px;
    height: 20px;
  }
  .pt-title {
    min-width: 0;
  }
  .pt-title b {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pt-title .mono {
    font-size: 12px;
    color: var(--fg-subtle);
  }
  .pt-kind {
    color: var(--fg-muted);
  }
  .pt-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .pt-share {
    height: 30px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    border-radius: 8px;
    background: var(--fg);
    color: var(--bg);
    font-size: 13px;
    font-weight: 500;
  }
  .pt-body {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
  }

  .pt-html {
    background: #f8fafc;
    color: #0f172a;
  }
  .report {
    height: 100%;
    box-sizing: border-box;
    padding: 22px 26px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .report-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }
  .report-titles {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .report-kicker {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #4f46e5;
  }
  .report-title {
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .report-sub {
    font-size: 12.5px;
    color: #64748b;
  }
  .report-controls {
    flex: none;
    display: flex;
    gap: 8px;
    font-size: 12.5px;
  }
  .seg {
    display: flex;
    padding: 3px;
    border-radius: 8px;
    background: #e2e8f0;
    color: #475569;
  }
  .seg span {
    padding: 4px 10px;
    border-radius: 6px;
  }
  .seg .on {
    background: #ffffff;
    color: #0f172a;
    font-weight: 500;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.12);
  }
  .chip {
    padding: 7px 12px;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    color: #334155;
  }
  .kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .kpi,
  .panel {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }
  .kpi {
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 12px;
    color: #64748b;
  }
  .kpi-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .kpi b {
    font-size: 24px;
    font-weight: 650;
    color: #0f172a;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .spark {
    width: 84px;
    height: 26px;
    overflow: visible;
  }
  .spark path {
    fill: none;
    stroke: #6366f1;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .kpi-delta {
    color: #059669;
  }
  .report-main {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
    gap: 14px;
  }
  .panel {
    min-height: 0;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
  }
  .panel-head b {
    font-weight: 600;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #64748b;
  }
  .key {
    display: inline-block;
    width: 10px;
    height: 3px;
    border-radius: 2px;
    margin-left: 6px;
  }
  .key.now {
    background: #6366f1;
  }
  .key.prev {
    background: #94a3b8;
  }
  .plot {
    position: relative;
    flex: 1;
    min-height: 0;
    padding: 0 0 22px 36px;
    display: flex;
    flex-direction: column;
  }
  .plot-area {
    position: relative;
    flex: 1;
  }
  .plot-area svg {
    position: absolute;
    inset: 0;
