---
interface Props {
  class?: string;
  label?: string;
}
const { class: className, label = "artiflow" } = Astro.props;
---

<svg class:list={["wordmark", className]} viewBox="-1.3 -0.3 101.6 21.6" role="img" aria-label={label}>
  <path d="M0 15 A5 5 0 0 1 10 15 A5 5 0 0 1 0 15 M10 10 V17 A3 3 0 0 0 13 20"></path>
  <path transform="translate(14.5 0)" d="M-2 20 A2 2 0 0 0 0 18 V15 A5 5 0 0 1 5 10"></path>
  <path transform="translate(23.5 0)" d="M3 3 V15 A5 5 0 0 0 8 20 H10.5 A3 3 0 0 0 13.5 17 V10 M0 10 H7"></path>
  <path transform="translate(40.5 0)" d="M3 20 V7 A4 4 0 0 1 7 3 H8 M0 10 H7"></path>
  <path transform="translate(53 0)" d="M0 2 V16 A4 4 0 0 0 4 20"></path>
  <path transform="translate(60.5 0)" d="M0 15 A5 5 0 0 1 10 15 A5 5 0 0 1 0 15"></path>
  <path transform="translate(75 0)" d="M0 10 V15 A4 4 0 0 0 8 15 A4 4 0 0 1 16 15 A4 4 0 0 0 24 15 V10"></path>
  <circle cx="37" cy="5.2" r="1.2"></circle>
</svg>

<style>
  .wordmark {
    display: block;
    width: 100%;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .wordmark circle {
    stroke: none;
    fill: var(--accent);
  }
</style>
