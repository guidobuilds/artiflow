---
import { agents } from "./agents";
---

<span class="agent-logos">
  {
    agents.map((a) => (
      <span class="agent-logo" title={a.name}>
        <svg viewBox={a.viewBox} width="16" height="16" role="img" aria-label={a.name}>
          <path d={a.d} fill={a.color ?? "currentColor"} fill-rule="evenodd" />
        </svg>
      </span>
    ))
  }
</span>

<style>
  .agent-logos {
    display: flex;
    gap: 4px;
  }
  .agent-logo {
    width: 30px;
    height: 30px;
    border-radius: 7px;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg);
  }
</style>
