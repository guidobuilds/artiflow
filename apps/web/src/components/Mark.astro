---
interface Props {
  class?: string;
  label?: string;
}
const { class: className, label = "artiflow" } = Astro.props;
---

<svg class:list={["mark", className]} viewBox="0 0 24 24" role="img" aria-label={label}>
  <path d="M3.5 19.5V12a5.5 5.5 0 0 1 11 0v7.5M17 6.5h4M14.5 13h5"></path>
  <circle cx="9" cy="15.5" r="2"></circle>
</svg>

<style>
  .mark {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mark circle {
    stroke: none;
    fill: var(--accent);
  }
</style>
