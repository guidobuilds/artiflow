# Application environment template.
#
# Copy this file to .env.local and fill the two external services. `npm run
# setup:local` does the copy and generates ARTIFLOW_AUTH_SECRET for you.
# This repository never starts, creates or provisions PostgreSQL or object
# storage; both are provided by the operator.
NODE_ENV=development
ARTIFLOW_API_HOST=127.0.0.1
ARTIFLOW_API_PORT=8787
ARTIFLOW_PUBLIC_ORIGIN=http://127.0.0.1:5173

# Local-only identity profile. Rejected in production and for non-loopback
# origins.
ARTIFLOW_DEMO_AUTH=1

# Better Auth signing secret. `setup:local` generates one; generate it yourself
# with `openssl rand -hex 32` if you create the file manually.
ARTIFLOW_AUTH_SECRET=

# External PostgreSQL 16. Use any host, port, database and role you control.
# Include sslmode=require/verify-full when the server requires TLS.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# External S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, Ceph,
# etc.). The bucket must already exist and stay private.
ARTIFLOW_S3_ENDPOINT=https://S3_ENDPOINT
ARTIFLOW_S3_REGION=us-east-1
ARTIFLOW_S3_BUCKET=artiflow
ARTIFLOW_S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
ARTIFLOW_S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
# Path-style addressing is required by most non-AWS providers and by R2.
ARTIFLOW_S3_FORCE_PATH_STYLE=1
